using Gtk 4.0;
using Adw 1;

template $ProxmoxCredentialPreferences: Adw.PreferencesGroup {
    title: _("Credentials");
    username: bind username_entry.text bidirectional;
    tokenid: bind tokenid_entry.text bidirectional;
    password_or_apikey: bind password_entry.text bidirectional;
    tfa_response: bind tfa_entry.text bidirectional;
    notify::use-apikey => $on_self_use_apikey_changed() swapped;
    description: _("The Proxmox user needs at least the permissions <tt>VM.Console</tt>, <tt>VM.Audit</tt> and <tt>VM.PowerMgmt</tt>.");

    Adw.ComboRow auth_mode_combo {
        title: _("Authentication Mode");
        notify::selected => $on_auth_mode_combo_selected() swapped;

        model: StringList {
            strings [
                _("Password"),
                _("API Key"),
            ]
        };
    }

    Adw.EntryRow tokenid_entry {
        visible: false;
        title: _("Token ID");
        activates-default: true;
    }

    Adw.EntryRow username_entry {
        title: _("Username");
        activates-default: true;
    }

    Adw.PasswordEntryRow password_entry {
        title: _("Password");
        activates-default: true;

        [suffix]
        $FieldMonitorSaveCredentialsButton password_entry_save_button {}
    }

    Adw.EntryRow tfa_entry {
        visible: false;
        title: _("Authentication code");
        input-purpose: digits;
        input-hints: no_spellcheck | no_emoji;
        activates-default: true;
    }

    Button {
        visible: bind tfa_entry.visible;
        label: _("Back to login details");
        halign: start;
        margin-top: 12;
        clicked => $on_back_to_login() swapped;
        styles ["flat"]
    }
}
