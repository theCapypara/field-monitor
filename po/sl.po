#: src/widget/quick_connect_dialog.blp:20
#, no-c-format
msgid ""
"Enter the URL of the server you want to connect to.\n"
"Supported protocols are: RDP, SPICE, VNC.\n"
"\n"
"<b>Examples:</b>\n"
"<i>rdp://full%20address=s:mypc:3389</i>\n"
"<i>spice://server:15900</i>\n"
"<i>spice://me@localhost:999?password=1234</i>\n"
"<i>vnc://user@server?VncPassword=password123</i>"
msgstr ""
"Vnesite URL strežnika, s katerim se želite povezati.\n"
"Podprti protokoli so RDP, SPICE in VNC.\n"
"\n"
"<b>Primeri:</b>\n"
"<i>rdp://full%20address=s:mypc:3389</i>\n"
"<i>spice://streznik:15900</i>\n"
"<i>spice://me@localhost:999?password=1234</i>\n"
"<i>vnc://uporabnik@streznik?VncPassword=password123</i>"

